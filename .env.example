# Docker Compose y conexión local. No reutilizar estos valores en producción.
POSTGRES_DB=congreso_nfc
POSTGRES_USER=congreso
POSTGRES_PASSWORD=reemplaza-con-una-clave-segura
SUPER_ADMIN_NAME=Superadministrador UTT
SUPER_ADMIN_EMAIL=administrador@tu-dominio.edu.mx
SUPER_ADMIN_PASSWORD=reemplaza-con-una-clave-segura-de-12-caracteres

DATABASE_URL=postgresql://congreso:reemplaza-con-una-clave-segura@localhost:5433/congreso_nfc
JWT_SECRET=reemplaza-con-una-clave-aleatoria-de-al-menos-32-caracteres

# Resend: completar únicamente en el VPS o en un entorno seguro.
RESEND_API_KEY=
EMAIL_FROM="Credenciales UTT <credenciales@tu-dominio.edu.mx>"

# Generar dos secretos diferentes y no versionarlos.
# CREDENTIAL_ENCRYPTION_KEY debe ser exactamente 32 bytes codificados en base64.
CREDENTIAL_ENCRYPTION_KEY=
EMAIL_WORKER_KEY=

